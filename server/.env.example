# CourtIQ backend — environment template.
# Copy to server/.env and fill in. NEVER commit the real .env.

ENVIRONMENT=development

# SQLite cache path is derived automatically; override only if needed.
# DATABASE_URL=sqlite:////absolute/path/to/courtiq.db

# nba_api ingestion tuning (seconds between requests; retry attempts).
NBA_API_REQUEST_DELAY_SECONDS=0.6
NBA_API_MAX_RETRIES=3

# LLM provider (M2). Leave blank until then.
LLM_API_KEY=
LLM_MODEL=

# Next.js dev origin for CORS.
FRONTEND_ORIGIN=http://localhost:3000
