# CourtIQ web — environment template. Copy to web/.env.local.

# Base path the browser uses to reach the API. Default routes through the
# Next.js rewrite in next.config.mjs to the local FastAPI backend.
NEXT_PUBLIC_API_BASE=/api

# Where the rewrite proxies to (server-side only).
API_PROXY_TARGET=http://127.0.0.1:5000
